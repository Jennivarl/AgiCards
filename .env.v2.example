# AgiCards v2 — MetaMask Smart Accounts Kit x 1Shot
# Copy the values you need into .env.local (never commit .env.local).

# --- Network: Base mainnet (REAL funds) ---
# ERC-7715 Advanced Permissions + Smart Accounts run on Base; spends are real,
# but capped on-chain per card. Optional RPC override; falls back to viem's Base RPC.
NEXT_PUBLIC_BASE_RPC_URL=
# Token the agent spends (defaults to Base USDC). Override only if needed.
# NEXT_PUBLIC_USDC_ADDRESS=

# --- 1Shot: PERMISSIONLESS public relayer (gasless EIP-7702/7710) ---
# No API key needed. Optional endpoint override + our public webhook URL.
ONESHOT_RELAYER_URL=https://relayer.1shotapi.com/relayers
PUBLIC_WEBHOOK_URL=

# --- Agent session key (Option B: server-side, always-on) ---
# Production: set AGENT_SIGNER_PROVIDER=turnkey|privy and the matching keys.
# Dev/testnet ONLY: a single throwaway private key. Not production-safe.
AGENT_SIGNER_PROVIDER=local
AGENT_LOCAL_PRIVATE_KEY=

# Managed signer (uncomment the set you use)
# TURNKEY_API_PUBLIC_KEY=
# TURNKEY_API_PRIVATE_KEY=
# TURNKEY_ORGANIZATION_ID=
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=

# --- Persistence: cards + executions ---
# Unset = in-memory (resets on restart, fine for demos).
# Set a Postgres URL (Neon/Supabase/Vercel Postgres) for durable storage.
DATABASE_URL=

# --- 0G Storage (reused as the audit/memory layer) ---
# Already documented for the 0G stack; the v2 audit trail writes here too.
# OG_STORAGE_INDEXER_RPC=
# OG_STORAGE_PRIVATE_KEY=
